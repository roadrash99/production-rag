# GitHub personal access token (no scopes needed for public repos)
GITHUB_TOKEN=

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face read token (optional; silences the unauthenticated-download warning)
HF_TOKEN=

# Local Postgres + pgvector from docker-compose.yml
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
